# Local emulators: no cloud credentials or credit card required.
# Never set emulator variables for a real Firebase project.
FIREBASE_PROJECT_ID=demo-cellxpress
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-cellxpress.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cellxpress

# Cloud mode: remove both EMULATOR_HOST variables, set USE_EMULATORS=false,
# replace all Firebase values with your project configuration, and supply:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional AI: manual intake works without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Set explicit rates for your selected model/tier. Blank = unknown, not free.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
GEMINI_PRICING_NOTE=
